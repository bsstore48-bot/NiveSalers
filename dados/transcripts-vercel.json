var(--kbs);\n      border: 1px solid var(--kgb);\n      border-radius: var(--kr);\n      padding: 20px 24px;\n      margin-bottom: 20px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      flex-wrap: wrap;\n      gap: 12px;\n    }\n\n    .ticket-banner .info {\n      display: flex;\n      align-items: center;\n      gap: 16px;\n    }\n    .ticket-banner .info .avatar {\n      width: 48px;\n      height: 48px;\n      border-radius: 50%;\n      background: linear-gradient(135deg, var(--ka), var(--ka2));\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-weight: 800;\n      font-size: 20px;\n      color: #fff;\n    }\n    .ticket-banner .info .details .name {\n      font-weight: 700;\n      font-size: 1rem;\n    }\n    .ticket-banner .info .details .sub {\n      font-size: 12px;\n      color: var(--kt2);\n    }\n\n    .ticket-banner .badge-status {\n      padding: 6px 16px;\n      border-radius: 9999px;\n      font-size: 11px;\n      font-weight: 700;\n      background: rgba(34, 197, 94, .12);\n      color: #22c55e;\n      border: 1px solid rgba(34, 197, 94, .2);\n    }\n\n    /* ============================================================\n       CONTAINER PRINCIPAL (simulando chat do Discord)\n       ============================================================ */\n    .chat-container {\n      width: 100%;\n      max-width: 820px;\n      background: var(--kbs);\n      border: 1px solid var(--kgb);\n      border-radius: var(--kr);\n      overflow: hidden;\n      box-shadow: var(--ks);\n    }\n\n    /* Cabeçalho do chat */\n    .chat-header {\n      padding: 16px 24px;\n      border-bottom: 1px solid var(--kgb);\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      background: var(--kgl);\n    }\n    .chat-header .lucide { width: 18px; height: 18px; color: var(--kt2); }\n    .chat-header span { font-size: 13px; font-weight: 600; color: var(--kt2); }\n    .chat-header .highlight { color: var(--ka); }\n\n    /* Área de mensagens */\n    .messages {\n      padding: 16px 20px;\n      max-height: 600px;\n      overflow-y: auto;\n      display: flex;\n      flex-direction: column;\n      gap: 16px;\n      background: var(--kbd);\n    }\n\n    /* ============================================================\n       MENSAGEM INDIVIDUAL\n       ============================================================ */\n    .message {\n      display: flex;\n      gap: 12px;\n      align-items: flex-start;\n      animation: fadeInUp .3s ease;\n    }\n    .message.system {\n      justify-content: center;\n    }\n    .message.system .system-msg {\n      background: var(--kg);\n      padding: 6px 16px;\n      border-radius: 9999px;\n      font-size: 12px;\n      color: var(--kt2);\n      border: 1px solid var(--kgb);\n    }\n\n    .message .msg-avatar {\n      width: 36px;\n      height: 36px;\n      border-radius: 50%;\n      flex-shrink: 0;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-weight: 700;\n      font-size: 14px;\n      color: #fff;\n    }\n    .message .msg-avatar.bot {\n      background: linear-gradient(135deg, var(--ka), var(--ka2));\n    }\n    .message .msg-avatar.user1 { background: #8b5cf6; }\n    .message .msg-avatar.user2 { background: #f59e0b; }\n    .message .msg-avatar.user3 { background: #ec4899; }\n    .message .msg-avatar.user4 { background: #14b8a6; }\n    .message .msg-avatar.user5 { background: #f472b6; }\n\n    .message .msg-content {\n      flex: 1;\n      min-width: 0;\n    }\n    .message .msg-content .msg-header {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      flex-wrap: wrap;\n      margin-bottom: 2px;\n    }\n    .message .msg-content .msg-header .username {\n      font-weight: 700;\n      font-size: 0.9rem;\n    }\n    .message .msg-content .msg-header .username.bot-name {\n      color: var(--ka);\n    }\n    .message .msg-content .msg-header .timestamp {\n      font-size: 10px;\n      color: var(--kt2);\n      font-family: 'Fira Code', monospace;\n    }\n    .message .msg-content .msg-header .badge-role {\n      font-size: 9px;\n      padding: 1px 8px;\n      border-radius: 9999px;\n      font-weight: 700;\n      background: var(--kg);\n      color: var(--kt2);\n    }\n    .message .msg-content .msg-header .badge-role.bot-badge {\n      background: rgba(0, 200, 255, .15);\n      color: var(--ka);\n    }\n\n    .message .msg-content .msg-text {\n      font-size: 0.92rem;\n      line-height: 1.6;\n      word-wrap: break-word;\n    }\n    .message .msg-content .msg-text .highlight-text {\n      color: var(--ka);\n      font-weight: 600;\n    }\n    .message .msg-content .msg-text .code-block {\n      background: var(--kgl);\n      padding: 2px 8px;\n      border-radius: 4px;\n      font-family: 'Fira Code', monospace;\n      font-size: 0.8rem;\n      border: 1px solid var(--kgb);\n    }\n\n    /* Embed dentro da mensagem */\n    .embed-message {\n      margin-top: 8px;\n      background: var(--kgl);\n      border-left: 4px solid var(--ka);\n      border-radius: 0 8px 8px 0;\n      padding: 12px 16px;\n      max-width: 480px;\n      border: 1px solid var(--kgb);\n      border-left-width: 4px;\n    }\n    .embed-message .embed-title {\n      font-weight: 700;\n      font-size: 0.95rem;\n      color: var(--kt);\n    }\n    .embed-message .embed-desc {\n      font-size: 0.85rem;\n      color: var(--kt2);\n      margin-top: 4px;\n    }\n    .embed-message .embed-field {\n      margin-top: 8px;\n      padding: 6px 10px;\n      background: var(--kgr);\n      border-radius: 6px;\n      border: 1px solid var(--kgb);\n    }\n    .embed-message .embed-field .field-name {\n      font-weight: 600;\n      font-size: 0.75rem;\n      color: var(--kt2);\n      text-transform: uppercase;\n      letter-spacing: .5px;\n    }\n    .embed-message .embed-field .field-value {\n      font-size: 0.85rem;\n      color: var(--kt);\n    }\n    .embed-message .embed-footer {\n      margin-top: 8px;\n      font-size: 0.7rem;\n      color: var(--kt2);\n      border-top: 1px solid var(--kgb);\n      padding-top: 6px;\n    }\n\n    .message .msg-content .msg-text .emoji {\n      font-size: 1.2rem;\n    }\n\n    /* ============================================================\n       DIVISOR DE DATA\n       ============================================================ */\n    .date-divider {\n      text-align: center;\n      padding: 12px 0 8px;\n      font-size: 11px;\n      color: var(--kt2);\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      justify-content: center;\n    }\n    .date-divider::before,\n    .date-divider::after {\n      content: '';\n      flex: 1;\n      height: 1px;\n      background: var(--kgb);\n      max-width: 80px;\n    }\n\n    /* ============================================================\n       FOOTER DO CHAT (simulando input)\n       ============================================================ */\n    .chat-footer {\n      padding: 12px 20px 16px;\n      border-top: 1px solid var(--kgb);\n      display: flex;\n      gap: 10px;\n      align-items: center;\n      background: var(--kgl);\n    }\n    .chat-footer .input-sim {\n      flex: 1;\n      padding: 10px 16px;\n      border-radius: 10px;\n      background: var(--kbd);\n      border: 1px solid var(--kgb);\n      font-size: 13px;\n      color: var(--kt2);\n      cursor: default;\n    }\n    .chat-footer .input-sim .lucide { width: 16px; height: 16px; vertical-align: middle; margin-right: 6px; }\n    .chat-footer .btn-sim {\n      padding: 8px 18px;\n      border-radius: 10px;\n      background: var(--kg);\n      border: 1px solid var(--kgb);\n      color: var(--kt2);\n      font-weight: 600;\n      font-size: 12px;\n      cursor: default;\n    }\n\n    /* ============================================================\n       BOTÃO DE TRANSCRIPT (simulado)\n       ============================================================ */\n    .transcript-info {\n      width: 100%;\n      max-width: 820px;\n      margin-top: 20px;\n      padding: 14px 20px;\n      background: var(--kbs);\n      border: 1px solid var(--kgb);\n      border-radius: var(--kr);\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      flex-wrap: wrap;\n      gap: 10px;\n    }\n    .transcript-info .left {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      font-size: 12px;\n      color: var(--kt2);\n    }\n    .transcript-info .left .lucide { width: 16px; height: 16px; color: var(--ka); }\n    .transcript-info .right {\n      display: flex;\n      gap: 10px;\n    }\n    .transcript-info .right .tag {\n      padding: 4px 14px;\n      border-radius: 9999px;\n      font-size: 10px;\n      font-weight: 700;\n      background: var(--kg);\n      color: var(--kt2);\n      border: 1px solid var(--kgb);\n    }\n    .transcript-info .right .tag.generated {\n      background: rgba(0, 200, 255, .1);\n      color: var(--ka);\n      border-color: rgba(0, 200, 255, .2);\n    }\n\n    /* ============================================================\n       ANIMAÇÕES\n       ============================================================ */\n    @keyframes fadeInUp {\n      from { opacity: 0; transform: translateY(12px); }\n      to { opacity: 1; transform: translateY(0); }\n    }\n\n    /* ============================================================\n       RESPONSIVO\n       ============================================================ */\n    @media (max-width: 600px) {\n      body { padding: 70px 12px 20px; }\n      .top-bar { padding: 10px 14px; flex-wrap: wrap; gap: 8px; }\n      .top-bar-left .back-btn span { display: none; }\n      .ticket-banner { padding: 16px; }\n      .ticket-banner .info .avatar { width: 40px; height: 40px; font-size: 16px; }\n      .messages { padding: 12px 14px; max-height: 450px; }\n      .message .msg-avatar { width: 30px; height: 30px; font-size: 12px; }\n      .message .msg-content .msg-text { font-size: 0.85rem; }\n      .embed-message { max-width: 100%; }\n      .chat-footer { flex-wrap: wrap; }\n      .chat-footer .input-sim { min-width: 100%; }\n      .transcript-info { flex-direction: column; align-items: flex-start; }\n    }\n\n    @media (max-width: 400px) {\n      .top-bar-left .ticket-id { font-size: 11px; padding: 2px 10px; }\n      .ticket-banner .info .details .name { font-size: 0.85rem; }\n    }\n  </style>\n</head>\n<body>\n\n  <!-- ============================================================\n       TOP BAR\n       ============================================================ -->\n  <header class=\"top-bar\">\n    <div class=\"top-bar-left\">\n      <a href=\"#\" class=\"back-btn\" onclick=\"history.back()\">\n        <i data-lucide=\"arrow-left\"></i>\n        <span>Voltar</span>\n      </a>\n      <span class=\"ticket-id\">#1549927252542627870</span>\n    </div>\n    <div class=\"top-bar-right\">\n      <span class=\"status-dot\"></span>\n      <span class=\"status-text\">Atendimento finalizado</span>\n    </div>\n  </header>\n\n  <!-- ============================================================\n       BANNER DO TICKET\n       ============================================================ -->\n  <div class=\"ticket-banner\">\n    <div class=\"info\">\n      <div class=\"avatar\">N</div>\n      <div class=\"details\">\n        <div class=\"name\">Nive Bots • Ticket</div>\n        <div class=\"sub\">Ticket criado em 24 de agosto de 2026 • 14:32</div>\n      </div>\n    </div>\n    <span class=\"badge-status\">✅ Finalizado</span>\n  </div>\n\n  <!-- ============================================================\n       CHAT CONTAINER\n       ============================================================ -->\n  <div class=\"chat-container\">\n\n    <!-- Cabeçalho do chat -->\n    <div class=\"chat-header\">\n      <i data-lucide=\"hash\"></i>\n      <span>ticket-<span cla