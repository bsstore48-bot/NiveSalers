# ============================================
# NiveSalers Ticket Bot - Configuração de Ambiente
# ============================================

# Token do Bot Discord
DISCORD_TOKEN="seu_token_aqui"

# Application ID (ID da Aplicação Discord)
APPLICATION_ID="seu_application_id_aqui"

# Porta do Servidor HTTP (O Render injeta automaticamente $PORT)
PORT=10000

# Sistema de Persistência em Nuvem (Render Cloud)
# Opção 1: MongoDB Atlas (Free Cluster)
MONGO_URI="mongodb+srv://usuario:senha@cluster0.mongodb.net/?retryWrites=true&w=majority"

# Opção 2: Backup e Sincronização automática via GitHub API
GITHUB_TOKEN="seu_github_token_aqui"
GITHUB_REPO="bsstore48-bot/NiveSalers"
